<h1 class="text-lg font-bold text-emerald-800">جلسة تحصين النفس والروح</h1>
</div>
<p class="text-xs text-slate-500">سيرة نبوية، قرآن، وتفسير صحيح</p>
</div>
</header>
​<!-- Main Container -->
<main class="max-w-4xl mx-auto px-4 py-8 flex-grow w-full">
​<!-- Book Card Wrapper -->
<div class="bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden">
